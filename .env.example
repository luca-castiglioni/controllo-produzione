# Copia questo file in ".env.local" e inserisci i valori del tuo progetto Supabase
# (pulsante "Connect" in alto nel progetto, oppure Project Settings → API Keys).
# Va qui SOLO la chiave "anon / publishable": è pensata per stare nel browser,
# i dati sono protetti dalle regole di sicurezza (RLS) in supabase/migrations/.
# La chiave "service_role / secret" NON va mai qui.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=incolla-qui-la-anon-key
